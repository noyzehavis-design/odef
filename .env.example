# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values reach the browser. Everything else is server-only. Never commit real values.

# ── Site ────────────────────────────────────────────────
# Public URL, used for magic-link redirects. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://odef.vercel.app

# ── Supabase (stage 0) ──────────────────────────────────
# Supabase → Project Settings → API Keys. Leave empty locally to run in demo mode (no login, mock data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated emails allowed to sign in. Server-only.
ALLOWED_EMAILS=you@example.com,partner@example.com

# ── Later stages (not used yet) ─────────────────────────
# Stage 3: server-only Supabase key for cron jobs (bypasses RLS, never in the browser)
SUPABASE_SECRET_KEY=
# Stage 3: Financy REST API (docs-financy.open-finance.ai)
FINANCY_CLIENT_ID=
FINANCY_CLIENT_SECRET=
FINANCY_USER_ID=
# Stage 3: protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Stage 4: Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Stage 5: Claude API
ANTHROPIC_API_KEY=
